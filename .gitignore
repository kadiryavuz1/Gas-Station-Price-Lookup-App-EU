*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
hs_err_pid*.log
replay_pid*.log

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/
.gradle/

# VS Code
.vscode/

# Tooling / scratch artifacts
.artifacts/

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/
.metadata

