# ==========================================================================
# Secrets & local configuration — never commit these
# ==========================================================================
# Build-time credentials (Supabase, etc.) injected via --dart-define-from-file
dart_define.json
*.env
.env
.env.*
!dart_define.json.example

# Signing material
**/*.keystore
**/*.jks
**/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Machine-specific generated config (leak local paths / SDK locations)
**/local.properties
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/

